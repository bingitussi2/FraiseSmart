{
  "name": "kivusense",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --lan --clear --port 19000",
    "phone": "expo start --lan --clear --port 19000",
    "phone:tunnel": "expo start --tunnel --clear --port 19000",
    "check": "tsc --noEmit && expo install --check",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "serve:web": "npx serve dist"
  },
  "dependencies": {
    "@expo/vector-icons": "15.0.3",
