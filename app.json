{
  "expo": {
    "name": "KivuSense",
    "slug": "kivusense",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/kivusense-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/kivusense-icon.png",
        "backgroundColor": "#0D1713"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/kivusense-icon.png",
      "bundler": "metro",
      "output": "single",
      "name": "KivuSense - Intelligence climatique agricole",
      "shortName": "KivuSense",
      "themeColor": "#123E32",
      "backgroundColor": "#0D1713"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/kivusense-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0D1713"
        }
      ],
      "expo-sharing",
      "expo-status-bar"
    ]
  }
}
